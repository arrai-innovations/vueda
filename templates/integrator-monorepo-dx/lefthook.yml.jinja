{% set js_exec = "pnpm exec" if js_package_manager == "pnpm" else "npx --no-install" if js_package_manager == "npm" else "yarn run" -%}
commit-msg:
    commands:
        commitlint:
            run: {{ js_exec }} commitlint --edit "$1"

pre-commit:
    parallel: false
    commands:
        fix-server:
            stage_fixed: true
            root: "server/"
            glob: "*.py"
            run: |
                uv run --no-sync ruff check --fix --show-fixes {staged_files}
                uv run --no-sync ruff format {staged_files}
        fix-client-eslint:
            stage_fixed: true
            root: "client/"
            glob: "*.{vue,js,cjs,mjs,ts,jsx,tsx}"
            run: {{ js_exec }} eslint --no-warn-ignored --cache --fix {staged_files}
        fix-client-prettier:
            stage_fixed: true
            root: "client/"
            glob: "*.{less,scss,css,vue,markdown,json,md,yml,yaml,html}"
            run: {{ js_exec }} prettier --write {staged_files}
        fix-md-toc:
            stage_fixed: true
            glob: "*.md"
            exclude: 'AGENTS?\.md$'
            run: uv run --no-sync python -m md_toc -p github {staged_files}
