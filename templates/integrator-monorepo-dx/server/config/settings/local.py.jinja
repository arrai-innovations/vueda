from config.settings.base import *  # noqa: F403
from config.settings.base import ROOT_DIR, env

CSRF_COOKIE_NAME = "{{ csrf_cookie_name }}"

CSRF_COOKIE_SECURE = False
SESSION_COOKIE_SECURE = False
CSRF_COOKIE_SAMESITE = "Lax"
SESSION_COOKIE_SAMESITE = "Lax"

# The info, permissions, and workflow overview pages, served when DEBUG is on, send an
# anonymous visitor here. It names the debug sign-in view that VUEDA serves beside them.
LOGIN_URL = "dev-login"

# Override VUEDA's default MEDIA_ROOT (/tmp/media), which every project on the machine
# would share. Uploaded files go to server/media/ instead. To use another directory,
# set MEDIA_ROOT in config.local.toml.
MEDIA_ROOT = env("MEDIA_ROOT", default=str(ROOT_DIR / "media"))

# Import patch_django in the leaf settings file (not base.py) so that
# PERMISSION_NAMES_MAPPING is fully resolved before the import triggers a lookup.
# If you override PERMISSION_NAMES_MAPPING above, place this import after that override.
from vueda.core import patch_django  # noqa: E402, F401
