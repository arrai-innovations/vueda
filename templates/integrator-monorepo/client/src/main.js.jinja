import { createApp } from "vue";
import { createPinia } from "pinia";
import { config as faConfig } from "@fortawesome/fontawesome-svg-core";
import "@fortawesome/fontawesome-svg-core/styles.css";
// Register all defaults before applying project patches. For per-component
// loading, omit this import; components register defaults when their modules load.
// Project patches must still run after the defaults they customize have loaded.
// Keep the base.css import in your stylesheet with either loading path.
import "@vueda/theme/vueda-tailwind/index.js";
import { installFontAwesomeFreeIcons } from "@vueda/theme/vueda-tailwind/icons/fontAwesomeFree.js";
import { setupDefaultListCrud } from "@vueda/utils/listCrud.js";
import { setupDefaultObjectCrud } from "@vueda/utils/objectCrud.js";
import { getRouter } from "./router/index.js";
import TheApp from "./TheApp.vue";

faConfig.autoAddCss = false;

installFontAwesomeFreeIcons();

// Lists, reads, and saves go through these adapters; without them every
// data request rejects with "Crud method ... is not implemented."
setupDefaultListCrud();
setupDefaultObjectCrud();

const app = createApp(TheApp);
const pinia = createPinia();
const router = getRouter(app, pinia);

app.use(pinia);
app.use(router);
app.mount("#the-app");

export default app;

