{
  "name": "@arrai-innovations/vueda",
  "version": "3.0.0-alpha.2",
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Vue 3 component library for VUEDA Server. Provides components and composables for form handling, CRUD views, and dynamic routing, driven by server-supplied model and field metadata. Includes authentication, navigation, permission management, and theming support.",
  "main": "index.js",
  "type": "module",
  "files": [
    "lib",
    "types",
    "README.md",
    "LICENSE",
    "index.js"
  ],
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "test": "npx --no-install vitest run",
    "coverage": "npm test -- --coverage",
    "lint": "pnpm -C .. exec eslint --no-warn-ignored --cache client",
    "format": "pnpm -C .. exec prettier --check client",
    "eslint": "pnpm -C .. exec eslint --no-warn-ignored --cache --fix client",
    "prettier": "pnpm -C .. exec prettier --write client",
    "build:types": "del-cli types && tsc",
    "prepublishOnly": "npm run build:types"
  },
