{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vueda.dev/schemas/docs-tooling/canonical.schema.json",
    "title": "DocBundle",
    "oneOf": [{ "$ref": "#/$defs/DocNodeBundle" }, { "$ref": "#/$defs/ThemeKeysBundle" }],
    "$defs": {
        "DocNodeBundle": {
            "type": "object",
            "title": "DocNodeBundle",
            "required": ["schemaVersion", "source", "nodes", "roots"],
            "additionalProperties": false,
            "properties": {
                "schemaVersion": { "type": "string" },
                "source": {
                    "type": "string",
                    "enum": ["openapi", "pdoc", "typedoc", "vue-docgen"]
                },
                "meta": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "title": { "type": "string" },
                        "version": { "type": "string" },
                        "sourcePath": { "type": "string" }
                    }
                },
                "nodes": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/DocNode" }
                },
                "roots": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "ThemeKeysBundle": {
            "type": "object",
            "title": "ThemeKeysBundle",
            "required": ["schemaVersion", "source", "families"],
            "additionalProperties": false,
            "properties": {
                "schemaVersion": { "type": "string" },
                "source": { "type": "string", "const": "theme-keys" },
                "families": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ThemeKeysFamily" }
                }
            }
        },
        "ThemeKeysFamily": {
            "type": "object",
            "required": ["name", "components"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "sourceFile": { "type": ["string", "null"] },
                "components": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ThemeKeysComponent" }
                }
            }
        },
        "ThemeKeysComponent": {
            "type": "object",
            "required": ["name", "kind", "slots"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["key", "primitive"] },
                "group": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] },
                "slots": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ThemeKeysSlot" }
                }
            }
        },
        "ThemeKeysSlot": {
            "type": "object",
            "required": ["id", "name", "kind", "valueShape"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["key", "primitive"] },
                "valueShape": { "type": "string", "enum": ["static", "callback"] },
                "defaultClasses": {
                    "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }]
                },
                "callbackSource": { "type": ["string", "null"] },
                "composes": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "description": { "type": ["string", "null"] },
                "group": { "type": ["string", "null"] },
                "source": { "$ref": "#/$defs/SourceLocation" }
            }
        },
        "DocNode": {
            "type": "object",
            "required": ["id", "kind", "name"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string" },
                "kind": {
                    "type": "string",
                    "enum": [
                        "module",
                        "namespace",
                        "class",
                        "interface",
                        "function",
                        "method",
                        "property",
                        "component",
                        "prop",
                        "slot",
                        "event",
                        "type",
                        "enum",
                        "api",
                        "endpoint",
                        "request",
                        "response",
                        "schema"
                    ]
                },
                "name": { "type": "string" },
                "displayName": { "type": "string" },
                "description": { "type": "string" },
                "children": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "signatures": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Signature" }
                },
                "members": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Member" }
                },
                "examples": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Example" }
                },
                "tags": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "lifecycle": { "$ref": "#/$defs/Lifecycle" },
                "typeDefinition": { "$ref": "#/$defs/TypeRef" },
                "propertyType": { "$ref": "#/$defs/TypeRef" },
                "source": { "$ref": "#/$defs/SourceLocation" },
                "extensions": {
                    "type": "object"
                }
            }
        },
        "Lifecycle": {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "properties": {
                "status": { "type": "string", "enum": ["deprecated"] },
                "description": { "type": "string" }
            }
        },
        "Signature": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string" },
                "parameters": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Parameter" }
                },
                "returns": { "$ref": "#/$defs/TypeRef" },
                "throws": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/TypeRef" }
                }
            }
        },
        "Parameter": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "type": { "$ref": "#/$defs/TypeRef" },
                "optional": { "type": "boolean" },
                "default": { "type": "string" },
                "members": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Member" }
                }
            }
        },
        "Member": {
            "type": "object",
            "required": ["name", "kind"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "kind": {
                    "type": "string",
                    "enum": ["property", "field", "prop"]
                },
                "description": { "type": "string" },
                "type": { "$ref": "#/$defs/TypeRef" },
                "required": { "type": "boolean" },
                "default": { "type": "string" },
                "readonly": { "type": "boolean" }
            }
        },
        "Example": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string" },
                "lang": { "type": "string" },
                "content": { "type": "string" }
            }
        },
        "TypeRef": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "kind": {
                    "type": "string",
                    "enum": ["primitive", "array", "object", "union", "enum", "reference"]
                },
                "link": { "type": "string" }
            }
        },
        "SourceLocation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "file": { "type": "string" },
                "line": { "type": "number" },
                "column": { "type": "number" },
                "url": { "type": "string" }
            }
        }
    }
}
